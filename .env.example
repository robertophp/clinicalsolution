# Copy to .env and fill with your values
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
TWILIO_AUTH=optional_twilio_token

# WhatsApp Cloud API (Meta) — ver docs/WHATSAPP_META.md
# META_APP_SECRET: App Secret de la app en developers.facebook.com (no commitear)
META_APP_SECRET=
# META_WABA_ID: ID de la cuenta WhatsApp Business (referencia; opcional para logs)
META_WABA_ID=
# Token de acceso de la app (temporal o de larga duración según tu flujo en Meta)
META_WHATSAPP_ACCESS_TOKEN=
# Mismo string que pongas como Verify token al configurar el webhook en Meta
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Solo local: true desactiva validación X-Hub-Signature-256 (no usar en producción)
META_WEBHOOK_SKIP_SIGNATURE_VERIFY=false

# Optional: conversation memory (Firestore)
# CONVERSATION_TTL_MINUTES=30
# CONVERSATION_MAX_HISTORY=5
# CONVERSATION_MAX_STORED=20
